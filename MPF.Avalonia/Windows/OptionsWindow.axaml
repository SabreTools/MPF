<local:WindowBase xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:core="clr-namespace:MPF.Avalonia"
                  xmlns:local="using:MPF.Avalonia.Windows"
                  xmlns:converters="using:MPF.Avalonia"
                  x:Class="MPF.Avalonia.Windows.OptionsWindow"
                  Width="540"
                  MinHeight="0"
                  MaxHeight="760"
                  SizeToContent="Height"
                  CanResize="False"
                  Title="{DynamicResource OptionsTitleString}">
    <local:WindowBase.Resources>
        <converters:ElementConverter x:Key="ElementConverter" />
    </local:WindowBase.Resources>
    <local:WindowBase.Styles>
        <Style Selector="Slider.default-speed-slider">
            <Setter Property="Height"
                    Value="18" />
            <Setter Property="MinHeight"
                    Value="18" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="RenderTransformOrigin"
                    Value="50%,50%" />
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1"
                                ScaleY="0.75" />
            </Setter>
        </Style>
        <Style Selector="Slider.default-speed-slider /template/ Thumb">
            <Setter Property="Width"
                    Value="16" />
            <Setter Property="Height"
                    Value="16" />
            <Setter Property="MinWidth"
                    Value="16" />
            <Setter Property="MinHeight"
                    Value="16" />
        </Style>
    </local:WindowBase.Styles>

    <Border Padding="6,0,6,3">
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="3">
            <TabControl x:Name="OptionsTabs"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{DynamicResource GeneralTabString}"
                                   FontSize="13.75"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2" />
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="0"
                                    Spacing="4">
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource UserInterfaceGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource EnableDarkModeCheckBoxString}"
                                                  IsChecked="{Binding Options.GUI.Theming.EnableDarkMode}"
                                                  ToolTip.Tip="(Experimental) Enable dark mode across the entire application" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource CheckForUpdatesCheckBoxString}"
                                                  IsChecked="{Binding Options.CheckForUpdatesOnStartup}"
                                                  ToolTip.Tip="Check for updates when the application starts" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource FastUpdateLabelCheckBoxString}"
                                                  IsChecked="{Binding Options.GUI.FastUpdateLabel}"
                                                  ToolTip.Tip="Bypasses disc checks to quickly update the output path. Use with caution!" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DefaultUILanguageLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultInterfaceLanguageComboBox"
                                                  Grid.Row="2"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding InterfaceLanguages}"
                                                  SelectedItem="{Binding Options.GUI.DefaultInterfaceLanguage, Converter={StaticResource ElementConverter}, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource DetectionGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource SkipSystemDetectCheckBoxString}"
                                                  IsChecked="{Binding Options.GUI.SkipSystemDetection}"
                                                  ToolTip.Tip="Disable trying to guess system (may improve performance at startup)" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource NoFixedDrivesCheckBoxString}"
                                                  IsChecked="{Binding Options.GUI.IgnoreFixedDrives}"
                                                  ToolTip.Tip="Ignore hard drives and other fixed drives" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DefaultSystemLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultSystemComboBox"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Systems}"
                                                  SelectedItem="{Binding Options.Dumping.DefaultSystem, Converter={StaticResource ElementConverter}, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource LoggingGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource VerboseLoggingCheckBoxString}"
                                                  IsChecked="{Binding Options.VerboseLogging}"
                                                  ToolTip.Tip="Display all logging statements" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource AutoOpenLogCheckBoxString}"
                                                  IsChecked="{Binding Options.GUI.OpenLogWindowAtStartup}"
                                                  ToolTip.Tip="Open the log panel when the program launches" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{DynamicResource PathsTabString}"
                                   FontSize="13.75"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2" />
                    </TabItem.Header>
                    <ScrollViewer>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,5">
                            <Grid Margin="0"
                                  ColumnDefinitions="166,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="4">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{DynamicResource AaruPathLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="AaruPathTextBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding Options.Dumping.AaruPath, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                                <Button x:Name="AaruPathButton"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Content="..."
                                        Click="BrowseForAaruPathClick"
                                        Width="26"
                                        MinHeight="23"
                                        Padding="0,2"
                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{DynamicResource DiscImageCreatorPathLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="DiscImageCreatorPathTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding Options.Dumping.DiscImageCreatorPath, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                                <Button x:Name="DiscImageCreatorPathButton"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Content="..."
                                        Click="BrowseForDiscImageCreatorPathClick"
                                        Width="26"
                                        MinHeight="23"
                                        Padding="0,2"
                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="{DynamicResource DreamdumpPathLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="DreamdumpPathTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding Options.Dumping.DreamdumpPath, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                                <Button x:Name="DreamdumpPathButton"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Content="..."
                                        Click="BrowseForDreamdumpPathClick"
                                        Width="26"
                                        MinHeight="23"
                                        Padding="0,2"
                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{DynamicResource RedumperPathLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="RedumperPathTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Text="{Binding Options.Dumping.RedumperPath, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                                <Button x:Name="RedumperPathButton"
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Click="BrowseForRedumperPathClick"
                                        Width="26"
                                        MinHeight="23"
                                        Padding="0,2"
                                        Content="..."
                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Row="4"
                                           Text="{DynamicResource DefaultDumpingProgramLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="InternalProgramComboBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailableInternalPrograms}"
                                          SelectedItem="{Binding Options.InternalProgram, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Text="{DynamicResource DefaultOutputPathLabelString}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Variables allowed:&#x0a;  &#37;SYSTEM&#37;&#9;(System name, long)&#x0a;  &#37;SYS&#37;&#9;&#9;(System name, short)&#x0a;  &#37;MEDIA&#37;&#9;(Media type)&#x0a;  &#37;PROGRAM&#37;&#9;(Program name, long)&#x0a;  &#37;PROG&#37;&#9;(Program name, short)&#x0a;  &#37;LABEL&#37;&#9;(Volume label)&#x0a;  &#37;DATE&#37;&#9;(Current date)&#x0a;  &#37;DATETIME&#37;&#9;(Current date and time)" />
                                <TextBox x:Name="DefaultOutputPathTextBox"
                                         Grid.Row="5"
                                         Grid.Column="1"
                                         Text="{Binding Options.Dumping.DefaultOutputPath, Mode=TwoWay}"
                                         ToolTip.Tip="Variables allowed:&#x0a;  &#37;SYSTEM&#37;&#9;(System name, long)&#x0a;  &#37;SYS&#37;&#9;&#9;(System name, short)&#x0a;  &#37;MEDIA&#37;&#9;(Media type)&#x0a;  &#37;PROGRAM&#37;&#9;(Program name, long)&#x0a;  &#37;PROG&#37;&#9;(Program name, short)&#x0a;  &#37;LABEL&#37;&#9;(Volume label)&#x0a;  &#37;DATE&#37;&#9;(Current date)&#x0a;  &#37;DATETIME&#37;&#9;(Current date and time)"
                                         VerticalAlignment="Center" />
                                <Button x:Name="DefaultOutputPathButton"
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Content="..."
                                        Click="BrowseForDefaultOutputPathClick"
                                        Width="26"
                                        MinHeight="23"
                                        Padding="0,2"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{DynamicResource DumpingTabString}"
                                   FontSize="13.75"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2" />
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="0"
                                    Spacing="4">
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource DumpingGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource UseRelativePathsCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.UseRelativePaths}"
                                                  ToolTip.Tip="Use relative paths when calling the dumping programs" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource ShowDiscInfoCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.MediaInformation.PromptForDiscInformation}"
                                                  ToolTip.Tip="Enable showing the media information output after dumping" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource PullAllInformationCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.Login.PullAllInformation}"
                                                  ToolTip.Tip="Instead of pulling a safe subset of data after dumping, enable pulling all comment and content data" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource EnableTabInputCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.MediaInformation.EnableTabsInInputFields}"
                                                  ToolTip.Tip="Enable entering tabs in supported input fields instead of tab navigation" />

                                        <CheckBox Grid.Row="2"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource EnableRedumpCompatibilityCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.MediaInformation.EnableRedumpCompatibility}"
                                                  ToolTip.Tip="Enable limiting outputs to only those supported by Redump" />

                                        <CheckBox Grid.Row="2"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource ShowEjectReminderCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.ShowDiscEjectReminder}"
                                                  ToolTip.Tip="Enable showing the disc eject reminder after information is gathered" />

                                        <CheckBox Grid.Row="3"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource AddPlaceholdersCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.MediaInformation.AddPlaceholders}"
                                                  ToolTip.Tip="Enable adding placeholder text in the output for required and optional fields" />

                                        <CheckBox Grid.Row="3"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource AddFilenameSuffixCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.AddFilenameSuffix}"
                                                  ToolTip.Tip="Enable appending the output filename to the generated files" />

                                        <CheckBox Grid.Row="4"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource OutputSubmissionJSONCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.OutputSubmissionJSON}"
                                                  ToolTip.Tip="Enable outputting a compressed JSON version of the submission info" />

                                        <CheckBox Grid.Row="4"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource IncludeArtifactsCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.IncludeArtifacts}"
                                                  IsEnabled="{Binding Options.Processing.OutputSubmissionJSON}"
                                                  ToolTip.Tip="Include log files in serialized JSON data [NOT RECOMMENDED TO USE]" />

                                        <CheckBox Grid.Row="5"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource CompressLogFilesCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.CompressLogFiles}"
                                                  ToolTip.Tip="Compress output log files to reduce space" />

                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource LogCompressionLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="LogCompressionComboBox"
                                                  Grid.Row="6"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding LogCompressions}"
                                                  SelectedItem="{Binding Options.Processing.LogCompression, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                                  IsEnabled="{Binding Options.Processing.CompressLogFiles}" />

                                        <CheckBox Grid.Row="7"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource DeleteUnnecessaryFilesCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.DeleteUnnecessaryFiles}"
                                                  ToolTip.Tip="Delete unnecesary output files to reduce space" />

                                        <CheckBox Grid.Row="7"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource CreatePS3IRDAfterDumpingCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.CreateIRDAfterDumping}"
                                                  ToolTip.Tip="Automatically creates an IRD file after dumping a PS3 disc" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource ProtectionGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowDefinitions="Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource EnableProtectionScanCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.ProtectionScanning.ScanForProtection}"
                                                  ToolTip.Tip="Enable automatic checking for copy protection on dumped media" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource ScanArchiveContentsCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.ProtectionScanning.ScanArchivesForProtection}"
                                                  ToolTip.Tip="Enable scanning archive contents during protection scanning (may drastically increase scanning time but is more accurate)" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource IncludeDebugInformationCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.ProtectionScanning.IncludeDebugProtectionInformation}"
                                                  ToolTip.Tip="Include debug information during protection scans" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource HideDriveLettersCheckBoxString}"
                                                  IsChecked="{Binding Options.Processing.ProtectionScanning.HideDriveLetters}"
                                                  ToolTip.Tip="Remove drive letters from protection scan output" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource DefaultSpeedsGroupBoxString}"
                                               FontWeight="Bold" />

                                    <Grid ColumnDefinitions="80,*,32"
                                          ColumnSpacing="4">
                                        <TextBlock Text="{DynamicResource CDLabelString}"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="DumpSpeedCDSlider"
                                                Classes="default-speed-slider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="72"
                                                IsSnapToTickEnabled="True"
                                                TickPlacement="BottomRight"
                                                Ticks="{Binding Source={x:Static core:Constants.SpeedsForCDAsCollection}}"
                                                Value="{Binding Options.Dumping.DumpSpeeds.CD, Mode=TwoWay}"
                                                TickFrequency="2" />
                                        <TextBox Grid.Column="2"
                                                 Width="32"
                                                 MinWidth="32"
                                                 MaxWidth="32"
                                                 Height="23"
                                                 MinHeight="23"
                                                 Padding="0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ElementName=DumpSpeedCDSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="80,*,32"
                                          ColumnSpacing="4">
                                        <TextBlock Text="{DynamicResource DVDLabelString}"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="DumpSpeedDVDSlider"
                                                Classes="default-speed-slider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="24"
                                                IsSnapToTickEnabled="True"
                                                TickPlacement="BottomRight"
                                                Ticks="{Binding Source={x:Static core:Constants.SpeedsForDVDAsCollection}}"
                                                Value="{Binding Options.Dumping.DumpSpeeds.DVD, Mode=TwoWay}"
                                                TickFrequency="2" />
                                        <TextBox Grid.Column="2"
                                                 Width="32"
                                                 MinWidth="32"
                                                 MaxWidth="32"
                                                 Height="23"
                                                 MinHeight="23"
                                                 Padding="0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ElementName=DumpSpeedDVDSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="80,*,32"
                                          ColumnSpacing="4">
                                        <TextBlock Text="{DynamicResource HDDVDLabelString}"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="DumpSpeedHDDVDSlider"
                                                Classes="default-speed-slider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="24"
                                                IsSnapToTickEnabled="True"
                                                TickPlacement="BottomRight"
                                                Ticks="{Binding Source={x:Static core:Constants.SpeedsForHDDVDAsCollection}}"
                                                Value="{Binding Options.Dumping.DumpSpeeds.HDDVD, Mode=TwoWay}"
                                                TickFrequency="2" />
                                        <TextBox Grid.Column="2"
                                                 Width="32"
                                                 MinWidth="32"
                                                 MaxWidth="32"
                                                 Height="23"
                                                 MinHeight="23"
                                                 Padding="0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ElementName=DumpSpeedHDDVDSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="80,*,32"
                                          ColumnSpacing="4">
                                        <TextBlock Text="{DynamicResource BDLabelString}"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="DumpSpeedBDSlider"
                                                Classes="default-speed-slider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="16"
                                                IsSnapToTickEnabled="True"
                                                TickPlacement="BottomRight"
                                                Ticks="{Binding Source={x:Static core:Constants.SpeedsForBDAsCollection}}"
                                                Value="{Binding Options.Dumping.DumpSpeeds.Bluray, Mode=TwoWay}"
                                                TickFrequency="1" />
                                        <TextBox Grid.Column="2"
                                                 Width="32"
                                                 MinWidth="32"
                                                 MaxWidth="32"
                                                 Height="23"
                                                 MinHeight="23"
                                                 Padding="0"
                                                 IsReadOnly="True"
                                                 Text="{Binding ElementName=DumpSpeedBDSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{DynamicResource ProgramsTabString}"
                                   FontSize="13.75"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2" />
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="0"
                                    Spacing="4">
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource AaruGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource AaruEnableDebugOutputCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Aaru.EnableDebug}"
                                                  ToolTip.Tip="Enable debug output in logs" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource AaruEnableVerboseOutputCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Aaru.EnableVerbose}"
                                                  ToolTip.Tip="Enable verbose output in logs" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource AaruForceDumpingCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Aaru.ForceDumping}"
                                                  ToolTip.Tip="Enable forcing dump even if there are issues" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource AaruStripPersonalDataCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Aaru.StripPersonalData}"
                                                  ToolTip.Tip="Enable stripping of personally identifiable information from metadata" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource AaruRereadTriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.Aaru.RereadCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many rereads are attempted for sector and subchannel errors" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource DiscImageCreatorGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource DiscImageCreatorQuietModeCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.DIC.QuietMode}"
                                                  ToolTip.Tip="Disable sounds (beeps) during and after operations" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource DiscImageCreatorParanoidModeCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.DIC.ParanoidMode}"
                                                  ToolTip.Tip="Enable pedantic and super-safe flags" />

                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource DiscImageCreatorUseCMIFlagCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.DIC.UseCMIFlag}"
                                                  ToolTip.Tip="Enable the CMI flag for supported disc types (DVD/HD-DVD only)" />

                                        <CheckBox x:Name="MultiSectorReadCheckBox"
                                                  Grid.Row="1"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource DiscImageCreatorMultiSectorReadCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.DIC.MultiSectorRead}"
                                                  ToolTip.Tip="Enable the /mr flag for BD drive dumping" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DiscImageCreatorMultiSectorReadValueLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.DIC.MultiSectorReadValue, Mode=TwoWay}"
                                                 IsEnabled="{Binding #MultiSectorReadCheckBox.IsChecked}"
                                                 ToolTip.Tip="Set the default value for the /mr flag" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DiscImageCreatorCDRereadTriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.DIC.RereadCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many rereads are attempted on C2 error [CD only]" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DiscImageCreatorDVDRereadTriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.DIC.DVDRereadCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many rereads are attempted on read error [DVD/HD-DVD/BD only]" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource DreamdumpGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DreamdumpRereadTriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.Dreamdump.RereadCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many rereads are attempted on read error" />

                                        <CheckBox x:Name="DreamdumpNonRedumpModeCheckBox"
                                                  Grid.Row="1"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource DreamdumpNonRedumpOptionsCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Dreamdump.NonRedumpMode}"
                                                  ToolTip.Tip="Enable non-redump options"
                                                  Click="DreamdumpNonRedumpModeClicked" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource DreamdumpDefaultSectorOrderLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultDreamdumpSectorOrderComboBox"
                                                  Grid.Row="2"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding DreamdumpSectorOrders}"
                                                  SelectedItem="{Binding Options.Dumping.Dreamdump.SectorOrder, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                                  IsEnabled="{Binding #DreamdumpNonRedumpModeCheckBox.IsChecked}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource RedumperGroupBoxString}"
                                               FontWeight="Bold" />
                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="16"
                                          RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource RedumperEnableVerboseOutputCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Redumper.EnableVerbose}"
                                                  ToolTip.Tip="Enable verbose output in logs" />

                                        <CheckBox Grid.Row="0"
                                                  Grid.Column="1"
                                                  Content="{DynamicResource RedumperEnableRefineSectorModeFlagCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Redumper.RefineSectorMode}"
                                                  ToolTip.Tip="Enable the refine sector mode flag by default" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperRereadTriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.Redumper.RereadCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many rereads are attempted on read error" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperPlextorLeadinRetriesLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.Redumper.LeadinRetryCount, Mode=TwoWay}"
                                                 ToolTip.Tip="Specifies how many retries are attempted for lead-in on Plextor drives" />

                                        <CheckBox x:Name="RedumperNonRedumpModeCheckBox"
                                                  Grid.Row="3"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource RedumperNonRedumpOptionsCheckBoxString}"
                                                  IsChecked="{Binding Options.Dumping.Redumper.NonRedumpMode}"
                                                  ToolTip.Tip="Enable non-redump options"
                                                  Click="RedumperNonRedumpModeClicked" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperDefaultReadMethodLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultRedumperReadMethodComboBox"
                                                  Grid.Row="4"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding RedumperReadMethods}"
                                                  SelectedItem="{Binding Options.Dumping.Redumper.ReadMethod, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                                  IsEnabled="{Binding #RedumperNonRedumpModeCheckBox.IsChecked}" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperDefaultSectorOrderLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultRedumperSectorOrderComboBox"
                                                  Grid.Row="5"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding RedumperSectorOrders}"
                                                  SelectedItem="{Binding Options.Dumping.Redumper.SectorOrder, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                                  IsEnabled="{Binding #RedumperNonRedumpModeCheckBox.IsChecked}" />

                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperDefaultDriveTypeLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="DefaultRedumperDriveTypeComboBox"
                                                  Grid.Row="6"
                                                  Grid.Column="1"
                                                  Width="220"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding RedumperDriveTypes}"
                                                  SelectedItem="{Binding Options.Dumping.Redumper.DriveType, Converter={StaticResource ElementConverter}, Mode=TwoWay}"
                                                  IsEnabled="{Binding #RedumperNonRedumpModeCheckBox.IsChecked}" />

                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="0"
                                                   Text="{DynamicResource RedumperDefaultDrivePregapStartLabelString}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="7"
                                                 Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding Options.Dumping.Redumper.DrivePregapStart, Mode=TwoWay}"
                                                 IsEnabled="{Binding #RedumperNonRedumpModeCheckBox.IsChecked}"
                                                 ToolTip.Tip="Specifies negative LBA for drive to start reading disc pregap from" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{DynamicResource LoginInfoTabString}"
                                   FontSize="13.75"
                                   FontWeight="Bold"
                                   Margin="0,0,0,2" />
                    </TabItem.Header>
                    <ScrollViewer>
                        <StackPanel Margin="0"
                                    Spacing="4">
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource RetrievalGroupBoxString}"
                                               FontWeight="Bold" />

                                    <CheckBox Grid.Row="0"
                                              Grid.Column="0"
                                              Content="{DynamicResource RetrieveMatchInformationCheckBoxString}"
                                              IsChecked="{Binding Options.Processing.Login.RetrieveMatchInformation}"
                                              ToolTip.Tip="Attempts to retrieve match information from Redump" />
                                </StackPanel>
                            </Border>

                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{DynamicResource WarningLabelString}"
                                     FontWeight="Bold"
                                     Foreground="Red" />
                                <Run Text="{DynamicResource OptionsRetrievalWarningString}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1"
                    Margin="0,0,0,2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,5">
                <Grid ColumnDefinitions="*,Auto,Auto,*"
                      ColumnSpacing="12">
                    <Button x:Name="AcceptButton"
                            Grid.Column="1"
                            Width="100"
                            Content="{DynamicResource AcceptButtonString}"
                            Click="OnAcceptClick" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Width="100"
                            Content="{DynamicResource CancelButtonString}"
                            Click="OnCancelClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:WindowBase>
